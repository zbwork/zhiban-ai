# Use a randomly generated hex password; no production credentials.
POSTGRES_PASSWORD=
OBJECT_PASSWORD=
WUKONG_WEBHOOK_SECRET=

# Optional applications: HTTPS origin and persistent random 32-byte Base64 key.
COMMUNITY_APP_ISSUER=
AGBUS_SECRETBOX_KEY=

# Model platforms synced from the desktop model service are encrypted with this key.
# Generate once with `openssl rand -base64 32`; keep it stable, or synced configs become unreadable.
AGBUS_AGENT_MODEL_KMS_DATA_KEY=

# Optional web search for local digital employees (SearchApi-compatible HTTPS endpoint).
# Leave empty to disable the search tool.
AGBUS_WEB_SEARCH_ENDPOINT=
AGBUS_WEB_SEARCH_API_KEY=

# Bus origin as reached by desktops; archived files from local employees upload through it.
# Defaults to http://127.0.0.1:18080. Use an HTTPS origin when desktops are on other machines.
AGBUS_EXTERNAL_URL=
