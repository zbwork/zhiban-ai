+fn canonicalize_home(path: &std::path::Path) -> std::io::Result<PathBuf> {
+    let result = path.canonicalize();
+    #[cfg(windows)]
+    if result
+        .as_ref()
+        .is_err_and(|error| error.kind() == std::io::ErrorKind::PermissionDenied)
+        && let Some(mappings) = std::env::var_os("LOCAL_AGENT_DOS_DEVICES")
+    {
+        use std::fs::OpenOptions;
+        use std::os::windows::ffi::{OsStrExt, OsStringExt};
+        use std::os::windows::fs::OpenOptionsExt;
+        use std::os::windows::io::AsRawHandle;
+        #[link(name = "kernel32")]
+        unsafe extern "system" {
+            fn GetFinalPathNameByHandleW(
+                handle: *mut std::ffi::c_void,
+                buffer: *mut u16,
+                size: u32,
+                flags: u32,
+            ) -> u32;
+        }
+        // Resolve the real kernel object (including reparse points). The supervisor
+        // supplies only the NT-volume-to-drive spelling; filesystem access stays
+        // subject to the unchanged AppContainer token and ACL checks.
+        let file = OpenOptions::new()
+            .access_mode(0)
+            .share_mode(7)
+            .custom_flags(0x02000000)
+            .open(path)?;
+        let size =
+            unsafe { GetFinalPathNameByHandleW(file.as_raw_handle(), std::ptr::null_mut(), 0, 2) };
+        if size == 0 {
+            return Err(std::io::Error::last_os_error());
+        }
+        let mut buffer = vec![0u16; size as usize + 1];
+        let count = unsafe {
+            GetFinalPathNameByHandleW(
+                file.as_raw_handle(),
+                buffer.as_mut_ptr(),
+                buffer.len() as u32,
+                2,
+            )
+        };
+        if count == 0 {
+            return Err(std::io::Error::last_os_error());
+        }
+        if count as usize >= buffer.len() {
+            return Err(std::io::Error::other(
+                "canonical path changed during resolution",
+            ));
+        }
+        buffer.truncate(count as usize);
+        let map: Vec<u16> = mappings.encode_wide().collect();
+        for entry in map.split(|c| *c == b'\n' as u16) {
+            if entry.len() < 4
+                || !((b'A' as u16)..=(b'Z' as u16)).contains(&entry[0])
+                || entry[1] != b':' as u16
+                || entry[2] != b'=' as u16
+            {
+                continue;
+            }
+            let device = &entry[3..];
+            if buffer.starts_with(device)
+                && (buffer.len() == device.len() || buffer[device.len()] == b'\\' as u16)
+            {
+                let mut resolved: Vec<u16> = r"\\?\".encode_utf16().collect();
+                resolved.extend_from_slice(&entry[..2]);
+                if buffer.len() == device.len() {
+                    resolved.push(b'\\' as u16);
+                }
+                resolved.extend_from_slice(&buffer[device.len()..]);
+                return Ok(PathBuf::from(std::ffi::OsString::from_wide(&resolved)));
+            }
+        }
+    }
+    result
+}
